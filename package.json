{
  "name": "khud",
  "version": "0.3.1",
  "description": "Cross-agent identity and memory compiler for AI coding agents. One profile compiled into Claude Code, Codex, OpenCode, Cursor, Pi and Hermes instruction files, with session memory into Obsidian.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "khud": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "link": "npm run build && npm link",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/capture-finalize.test.mjs tests/repair-regressions.test.mjs tests/session-note-dedupe.test.mjs tests/prompt-echo-guard.test.mjs tests/context-preview.test.mjs tests/context-sync.test.mjs",
    "test:focused": "npm run build && node --test tests/repair-regressions.test.mjs"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agent",
    "ai-coding-assistant",
    "claude",
    "claude-code",
    "cursor",
    "opencode",
    "agent-memory",
    "cross-agent",
    "context-management",
    "shared-context",
    "developer-tools",
    "automation",
    "cli",
    "obsidian",
    "agents-md",
    "claude-md",
    "cursorrules",
    "instruction-files",
    "codex",
    "codex-cli",
    "pi",
    "hermes",
    "agent-identity",
    "ai-memory"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bilalkpoecs/khud.git"
  },
  "homepage": "https://github.com/Bilalkpoecs/khud#readme",
  "bugs": {
    "url": "https://github.com/Bilalkpoecs/khud/issues"
  },
  "author": "Bilal Ahmad"
}
